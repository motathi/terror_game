; Engine configuration file.
; Godot 4.x — renderer Compatibility (WebGL2 / OpenGL ES 3) para rodar em
; navegador mobile, Android e iOS com o mesmo visual PSX.

config_version=5

[application]

config/name="Escolha-me"
config/description="Terror de escolhas em primeira pessoa, estilo PSX."
config/version="0.1.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[audio]

; Web: o Godot mistura o áudio (modo Stream). O modo "Sample" ignora
; os buses criados em código (Phone/Radio/Muffled) e ficava mudo.
general/default_playback_type.web=0

[autoload]

GameState="*res://autoload/game_state.gd"
Audio="*res://autoload/audio_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=0
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
