[gd_resource type="AudioBusLayout" load_steps=7 format=3]

[sub_resource type="AudioEffectBandPassFilter" id="phone_bp"]
resource_name = "BandPassFilter"
cutoff_hz = 1700.0

[sub_resource type="AudioEffectDistortion" id="phone_dist"]
resource_name = "Distortion"
drive = 0.25
post_gain = -4.0

[sub_resource type="AudioEffectBandPassFilter" id="radio_bp"]
resource_name = "BandPassFilter"
cutoff_hz = 1200.0

[sub_resource type="AudioEffectReverb" id="radio_rv"]
resource_name = "Reverb"
room_size = 0.3
wet = 0.15

[sub_resource type="AudioEffectLowPassFilter" id="muffled_lp"]
resource_name = "LowPassFilter"
cutoff_hz = 900.0

[resource]
bus/1/name = &"Music"
bus/1/solo = false
