{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'sem dependências npm'",
  "buildCommand": "bash tools/vercel_build.sh",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)\\.(wasm|pck|js|html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
